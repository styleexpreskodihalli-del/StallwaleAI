# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (Production domain: https://stallwale.in).
# AI Studio automatically injects this at runtime with the Cloud Run service URL or custom domain.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://stallwale.in"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID for Google Business Profile API access.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# RAZORPAY_PAYMENT_LINK_INR: Official ₹499 / 30 days Razorpay subscription payment link (India).
RAZORPAY_PAYMENT_LINK_INR="https://rzp.io/rzp/DU1C4ZXH"
RAZORPAY_PLAN_ID_INR="plan_stallwale_inr_499_30d"

# RAZORPAY_PAYMENT_LINK_AED: Official AED 60 / 30 days Razorpay subscription payment link (UAE).
RAZORPAY_PAYMENT_LINK_AED="https://rzp.io/rzp/DU1C4ZXH"
RAZORPAY_PLAN_ID_AED="plan_stallwale_aed_60_30d"




# Optional GA4 Measurement ID shared with stallwale.in (for example G-XXXXXXXXXX).
# Keep blank until a GA4 property exists; analytics loads only after visitor consent.
GA_MEASUREMENT_ID=""
